# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas `.env` al repositorio (ya está ignorado por .gitignore).
# MONGODB_URI es OPCIONAL: sin ella el backend usa el catálogo simulado local.
# Configuración de la simulación académica AWS.

PORT=3001
NODE_ENV=development
# Límite de peticiones por minuto
RATE_LIMIT_PER_MIN=120

# Origen permitido por CORS (solo necesario en producción). Ejemplo:
# FRONTEND_URL=https://cloudcalc.onrender.com

# Credenciales AWS (Price List API, solo lectura). El backend exige AMBAS
# variables para cotizar EC2 con precios reales: si faltan, /api/aws/ec2/*
# responde 503. En Render se configuran como secretos (Settings > Environment).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# URI de MongoDB Atlas (opcional). Copia el valor completo desde
# Atlas > Connect > Drivers (empieza por `mongodb+srv://`, solo en tu `.env`).
# En Render se define como secreto. Atlas debe permitir la IP de salida de Render
# en Network Access (no cambies la seguridad de Atlas sin revisarlo antes).
# MONGODB_URI=

# Simulación de red: latencia artificial (ms) y tasa de errores (0..1).
# En producción (Render) se dejan a 0: SIMULATE_LATENCY_MS=0, SIMULATE_ERROR_RATE=0.
SIMULATE_LATENCY_MS=400
SIMULATE_ERROR_RATE=0
