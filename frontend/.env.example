# Nombre por defecto: 'mock' (sin backend). Cambia a 'http' para usar el backend.
#   VITE_PRICING_PROVIDER=mock|http
VITE_PRICING_PROVIDER=mock

# URL base de la API.
#   - /api                    -> relativo al mismo origen (proxy de Vite en desarrollo)
#   - https://<backend>/api   -> URL absoluta del backend en Render (producción)
# En Render se usa VITE_API_URL (tiene prioridad sobre este valor en el build):
#   VITE_API_URL=https://cloudcalc-backend.onrender.com/api
VITE_API_BASE=/api
